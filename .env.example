# Copy to .env for local runs. Never commit .env (it's git-ignored).

# ---- App ----
# development (default) or production (JSON logs, HSTS, Secure cookies, no dev mail)
APP_ENV=development
# Public URL of the site, used in password reset emails. Required in production.
APP_URL=

# ---- AI (Groq) ----  free key: https://console.groq.com/keys
# Leave empty to run in offline rules mode.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# Llama 3.3 70B was retired from Groq. Alternatives: qwen/qwen3.8-27b, openai/gpt-oss-20b
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT=20
# Groq's free tier allows ~8,000 tokens/minute. Batches use AI for this many seconds,
# then finish with offline rules (each lead says which engine read it).
BATCH_AI_SECONDS=60
# Draft batch replies with AI too (uses about twice the quota)
BATCH_AI_SMS=false

# ---- Database ----
# Empty = SQLite file at DB_PATH (default ./leadscout.db). Set a PostgreSQL URL to use Postgres.
DATABASE_URL=
DB_PATH=

# ---- Email for password reset (optional) ----
# Without SMTP, development prints reset emails to the server log.
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USER=you@gmail.com SMTP_PASSWORD=<App Password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# ---- Security / limits ----
# Session cookie Secure flag: auto (on over HTTPS), true or false. Production default: true
COOKIE_SECURE=auto
RATE_LIMIT_SCORE_PER_MIN=30
RATE_LIMIT_BATCH_PER_MIN=6
RATE_LIMIT_AUTH_PER_MIN=10

# ---- Logging ----
LOG_LEVEL=INFO
# text or json (production default: json)
LOG_FORMAT=

# ---- Admins ----
# Comma-separated emails that get the admin role (see all users and everyone's activity log)
ADMIN_EMAILS=
